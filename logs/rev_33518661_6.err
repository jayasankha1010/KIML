    (11): ELU(alpha=1.0)
    (12): Linear(25, 1, bias=True)
  )
  (mp): Sequential(
    (0) - FiLMConv(50, 50, num_relations=2): x, edge_index -> x
    (1) - ELU(alpha=1.0): x -> x
    (2) - InstanceNorm(50): x -> x
    (3) - FiLMConv(50, 50, num_relations=2): x, edge_index -> x
    (4) - ELU(alpha=1.0): x -> x
    (5) - InstanceNorm(50): x -> x
  )
)
